# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real secrets.

# --- Server ---
PORT=3000
SERVER=localhost
CLIENT_ORIGIN=http://localhost:5173

# Directory (relative to project root) from which the server
# serves the built Vue client. Used in production on Render.
STATIC_DIR=client/dist

# --- Supabase ---
# Get these from your Supabase project dashboard:
#   Settings -> API
# Use the "service_role" key — this runs server-side only and
# MUST NOT be exposed to the client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# --- JWT ---
# Long random string. Never share. Rotate if leaked.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
