{
    "name": "nature-runner-server",
    "version": "1.0.0",
    "description": "Backend for the Nature Runner fitness app (Thomas Napolitano, S26 Web Server Programming)",
    "license": "ISC",
    "author": "Thomas Napolitano",
    "scripts": {
        "build": "tsc && npm --prefix client install && npm --prefix client run build",
        "start": "node dist/index.js",
        "dev": "tsx watch server/index.ts",
        "dev:client": "npm --prefix client run dev"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.45.4",
        "bcryptjs": "^2.4.3",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.2"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^24.0.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}
